	cpus {
		#address-cells = < 0x1 >; /* in zephyr/boards/arm/mps2/mps2_an521_cpu0.dts:72 */
		#size-cells = < 0x0 >;    /* in zephyr/boards/arm/mps2/mps2_an521_cpu0.dts:73 */

