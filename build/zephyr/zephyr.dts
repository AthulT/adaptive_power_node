				};

				/* node '/soc/peripheral@50000000/pinctrl/sbcon1_default' defined in zephyr/boards/arm/mps2/mps2-pinctrl.dtsi:63 */
				sbcon1_default: sbcon1_default {
					phandle = < 0x6 >; /* in zephyr/boards/arm/mps2/mps2_an521-common.dtsi:163 */

					/* node '/soc/peripheral@50000000/pinctrl/sbcon1_default/group1' defined in zephyr/boards/arm/mps2/mps2-pinctrl.dtsi:64 */
					group1 {
						pinmux = < 0x7e >,
						         < 0xa6 >; /* in zephyr/boards/arm/mps2/mps2-pinctrl.dtsi:65 */
						input-enable;      /* in zephyr/boards/arm/mps2/mps2-pinctrl.dtsi:66 */
					};
				};
			};
		};
	};

	/* node '/leds' defined in zephyr/boards/arm/mps2/mps2_an521_cpu0.dts:41 */
	leds {
