			/* node '/soc/peripheral@50000000/eth@2000000' defined in zephyr/boards/arm/mps2/mps2_an521-common.dtsi:195 */
			eth0: eth@2000000 {
				compatible = "smsc,lan9220";  /* in zephyr/boards/arm/mps2/mps2_an521-common.dtsi:197 */
				reg = < 0x2000000 0x100000 >; /* in zephyr/boards/arm/mps2/mps2_an521-common.dtsi:199 */
				interrupts = < 0x30 0x3 >;    /* in zephyr/boards/arm/mps2/mps2_an521-common.dtsi:200 */
			};

			/* node '/soc/peripheral@50000000/pinctrl' defined in zephyr/boards/arm/mps2/mps2_an521-common.dtsi:203 */
			pinctrl: pinctrl {
				compatible = "arm,mps2-pinctrl"; /* in zephyr/boards/arm/mps2/mps2_an521-common.dtsi:204 */
				status = "okay";                 /* in zephyr/boards/arm/mps2/mps2_an521-common.dtsi:205 */

				/* node '/soc/peripheral@50000000/pinctrl/uart3_default' defined in zephyr/boards/arm/mps2/mps2-pinctrl.dtsi:10 */
				uart3_default: uart3_default {
					phandle = < 0x3 >; /* in zephyr/boards/arm/mps2/mps2_an521-common.dtsi:116 */

					/* node '/soc/peripheral@50000000/pinctrl/uart3_default/group1' defined in zephyr/boards/arm/mps2/mps2-pinctrl.dtsi:11 */
					group1 {
						pinmux = < 0x10 >; /* in zephyr/boards/arm/mps2/mps2-pinctrl.dtsi:12 */
					};

					/* node '/soc/peripheral@50000000/pinctrl/uart3_default/group2' defined in zephyr/boards/arm/mps2/mps2-pinctrl.dtsi:15 */
					group2 {
						pinmux = < 0x0 >; /* in zephyr/boards/arm/mps2/mps2-pinctrl.dtsi:16 */
						input-enable;     /* in zephyr/boards/arm/mps2/mps2-pinctrl.dtsi:17 */
					};
				};

				/* node '/soc/peripheral@50000000/pinctrl/uart4_default' defined in zephyr/boards/arm/mps2/mps2-pinctrl.dtsi:21 */
				uart4_default: uart4_default {
					phandle = < 0x4 >; /* in zephyr/boards/arm/mps2/mps2_an521-common.dtsi:127 */

					/* node '/soc/peripheral@50000000/pinctrl/uart4_default/group1' defined in zephyr/boards/arm/mps2/mps2-pinctrl.dtsi:22 */
					group1 {
						pinmux = < 0x78 >; /* in zephyr/boards/arm/mps2/mps2-pinctrl.dtsi:23 */
					};

					/* node '/soc/peripheral@50000000/pinctrl/uart4_default/group2' defined in zephyr/boards/arm/mps2/mps2-pinctrl.dtsi:26 */
					group2 {
						pinmux = < 0x68 >; /* in zephyr/boards/arm/mps2/mps2-pinctrl.dtsi:27 */
						input-enable;      /* in zephyr/boards/arm/mps2/mps2-pinctrl.dtsi:28 */
					};
