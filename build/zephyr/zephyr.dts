				/* node '/soc/peripheral@50000000/pinctrl/sbcon0_default' defined in zephyr/boards/arm/mps2/mps2-pinctrl.dtsi:56 */
				sbcon0_default: sbcon0_default {
					phandle = < 0x5 >; /* in zephyr/boards/arm/mps2/mps2_an521-common.dtsi:153 */

					/* node '/soc/peripheral@50000000/pinctrl/sbcon0_default/group1' defined in zephyr/boards/arm/mps2/mps2-pinctrl.dtsi:57 */
					group1 {
						pinmux = < 0x16 >,
						         < 0x3e >; /* in zephyr/boards/arm/mps2/mps2-pinctrl.dtsi:58 */
						input-enable;      /* in zephyr/boards/arm/mps2/mps2-pinctrl.dtsi:59 */
