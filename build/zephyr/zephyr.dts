			compatible = "arm,cortex-m33"; /* in zephyr/boards/arm/mps2/mps2_an521_cpu0.dts:77 */
			reg = < 0x0 >;                 /* in zephyr/boards/arm/mps2/mps2_an521_cpu0.dts:78 */
			#address-cells = < 0x1 >;      /* in zephyr/boards/arm/mps2/mps2_an521_cpu0.dts:79 */
