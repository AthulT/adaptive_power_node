				phandle = < 0x8 >;              /* in zephyr/boards/arm/mps2/mps2_an521_cpu0.dts:60 */
			};

			/* node '/soc/peripheral@50000000/mps2_fpgaio@30204c' defined in zephyr/boards/arm/mps2/mps2_an521-common.dtsi:186 */
			gpio_misc: mps2_fpgaio@30204c {
				compatible = "arm,mmio32-gpio"; /* in zephyr/boards/arm/mps2/mps2_an521-common.dtsi:187 */
				reg = < 0x30204c 0x4 >;         /* in zephyr/boards/arm/mps2/mps2_an521-common.dtsi:189 */
				gpio-controller;                /* in zephyr/boards/arm/mps2/mps2_an521-common.dtsi:190 */
				#gpio-cells = < 0x1 >;          /* in zephyr/boards/arm/mps2/mps2_an521-common.dtsi:191 */
				ngpios = < 0xa >;               /* in zephyr/boards/arm/mps2/mps2_an521-common.dtsi:192 */
