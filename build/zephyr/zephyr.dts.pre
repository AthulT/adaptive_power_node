# 1 "/home/athul/Workspace/Zephyr/zephyr/include/zephyr/dt-bindings/pinctrl/arm-mps2-pinctrl.h" 1 3 4
# 8 "/home/athul/Workspace/Zephyr/zephyr/boards/arm/mps2/mps2-pinctrl.dtsi" 2

&pinctrl {
 /omit-if-no-ref/ uart3_default: uart3_default {
  group1 {
   pinmux = <(4 << 2 | 0 << 0)>;
  };

  group2 {
   pinmux = <(0 << 2 | 0 << 0)>;
   input-enable;
  };
 };

 /omit-if-no-ref/ uart4_default: uart4_default {
  group1 {
   pinmux = <(30 << 2 | 0 << 0)>;
  };

  group2 {
   pinmux = <(26 << 2 | 0 << 0)>;
   input-enable;
  };
 };

 /omit-if-no-ref/ spi0_default: spi0_default {
  group1 {
   pinmux = <(11 << 2 | 3 << 0)>, <(12 << 2 | 3 << 0)>,
     <(13 << 2 | 3 << 0)>;
  };

  group2 {
   pinmux = <(14 << 2 | 3 << 0)>;
   input-enable;
  };
 };

 /omit-if-no-ref/ spi1_default: spi1_default {
  group1 {
   pinmux = <(44 << 2 | 3 << 0)>, <(38 << 2 | 3 << 0)>,
     <(39 << 2 | 3 << 0)>;
  };

  group2 {
   pinmux = <(40 << 2 | 3 << 0)>;
   input-enable;
  };
 };

 /omit-if-no-ref/ sbcon0_default: sbcon0_default {
  group1 {
   pinmux = <(5 << 2 | 2 << 0)>, <(15 << 2 | 2 << 0)>;
   input-enable;
  };
 };

 /omit-if-no-ref/ sbcon1_default: sbcon1_default {
  group1 {
   pinmux = <(31 << 2 | 2 << 0)>, <(41 << 2 | 2 << 0)>;
   input-enable;
  };
 };
};
